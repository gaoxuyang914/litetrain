# Copy to backend/.env and edit for your machine.
# All variables use the LITETRAIN_ prefix.

LITETRAIN_ENVIRONMENT=development
LITETRAIN_HOST=127.0.0.1
LITETRAIN_PORT=8000

# SQLite is the durable source of truth. Relative defaults live in backend/data.
# LITETRAIN_DATABASE_URL=sqlite:///D:/path/to/litetrain/backend/data/platform.db

# Logical CPU inventory exposed by the scheduler.
LITETRAIN_TOTAL_CPUS=8
LITETRAIN_USER_CPU_QUOTA=8
LITETRAIN_NODE_NAME=local-cpu
LITETRAIN_DEFAULT_CPU_CORES=4

# Scheduler/watchdog timings.
LITETRAIN_SCHEDULER_INTERVAL_SECONDS=1.0
LITETRAIN_HEARTBEAT_INTERVAL_SECONDS=4
LITETRAIN_HEARTBEAT_TIMEOUT_SECONDS=25
LITETRAIN_DEFAULT_MAX_RUNTIME_SECONDS=1800

# auto tries Ray first and falls back to local subprocesses.
LITETRAIN_EXECUTION_MODE=auto
LITETRAIN_RAY_GCS_ADDRESS=127.0.0.1:6380
LITETRAIN_RAY_DASHBOARD_URL=http://127.0.0.1:8265
LITETRAIN_RAY_NAMESPACE=litetrain
LITETRAIN_RAY_ACTOR_START_TIMEOUT_SECONDS=40

# Redis 5.x (the Windows port) does not understand HELLO, so protocol 2.
LITETRAIN_REDIS_URL=redis://127.0.0.1:6379/0
LITETRAIN_REDIS_PROTOCOL=2
LITETRAIN_REDIS_ENABLED=true

# Worker callbacks. Keep host/port aligned with the backend.
LITETRAIN_WORKER_API_BASE=http://127.0.0.1:8000/api/v1
# Optional explicit interpreter used by Ray/local worker subprocesses.
# LITETRAIN_WORKER_PYTHON=D:/path/to/litetrain/.venv/Scripts/python.exe

# P2 pipeline + webhook outbox
LITETRAIN_PIPELINE_DEFAULT_MAX_IMAGES=24
LITETRAIN_WEBHOOK_MAX_ATTEMPTS=4
LITETRAIN_WEBHOOK_RETRY_BASE_SECONDS=2
LITETRAIN_WEBHOOK_TIMEOUT_SECONDS=5
LITETRAIN_WEBHOOK_DISPATCHER_INTERVAL_SECONDS=1

# Serve the built Vue app from FastAPI when frontend/dist exists.
LITETRAIN_SERVE_FRONTEND=true
LITETRAIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
